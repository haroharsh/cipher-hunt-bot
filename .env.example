DISCORD_TOKEN=
DATABASE_URL=postgresql://user:password@localhost:5432/ciphers
# Comma-separated Discord IDs allowed to run admin commands (users with the Administrator permission also qualify)
ADMIN_USER_IDS=
ADMIN_ROLE_IDS=
# Optional: admin commands only accepted in this channel
ADMIN_CHANNEL_ID=
LEADERBOARD_CHANNEL_ID=
LOG_CHANNEL_ID=
# Local image folder (question image may also be an https URL)
IMAGES_DIR=./images
# Answer normalization (trim + case-insensitive is always on)
NORMALIZE_COLLAPSE_SPACES=false
NORMALIZE_STRIP_SPACES=false
NORMALIZE_STRIP_PUNCTUATION=false
